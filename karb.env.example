# Karb configuration. Deployed to /etc/karb.env (root:root, 0644 - it holds
# paths and a mode, no secrets; the secrets are in ~/.karb-secrets).
#
# Two phases, and the difference between them is the whole security story.

# --- Phase 1: testing on the LAN, before the tunnel exists -----------------
# Reachable at http://karb.lan. Identity is whatever the browser claims, which
# is what Karb always did on Home Dock. Fine here, fatal once published.
#
# KARB_AUTH=picker
# KARB_BIND=0.0.0.0:80

# --- Phase 2: published at karb.bill.computer ------------------------------
# Bound to localhost, so the only way in is cloudflared on this same box, and
# the only way through that is Cloudflare Access. Identity comes from the
# Cf-Access-Authenticated-User-Email header; a request without one is refused.
KARB_AUTH=access
KARB_BIND=127.0.0.1:8080

KARB_DATA=/home/emily/karb-data
KARB_SECRETS=/home/emily/.karb-secrets
KARB_USERS=/home/emily/.karb-secrets/users.json
